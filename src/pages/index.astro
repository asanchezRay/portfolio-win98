---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Panel from '../components/Panel.astro';
import Cifras from '../components/Cifras.astro';
import Taller from '../components/Taller.astro';
import Organizacion from '../components/Organizacion.astro';
import Abribles from '../components/Abribles.astro';
import { perfil } from '../data/perfil';
import { taller } from '../data/taller';
import { trayectoria, rango } from '../data/trayectoria';

const totalCasos = (await getCollection('casos')).length;

const enMarcha = taller.filter((p) =>
  ['en curso', 'en producción', 'continuo'].includes(p.estado)
).length;

const resumenTrayectoria = trayectoria.filter((e) => e.via === 'industria').slice(0, 4);

const { contacto } = perfil;
---

<Base
  titulo={`${perfil.nombre} — ${perfil.rol} en ${perfil.organizacion}`}
  tituloCrudo
  descripcion="Líder técnico y senior software engineer. Software en dominios que no se parecen entre sí: mercado eléctrico, nómina multipaís, salud y marketplaces."
>
  <div class="consola">
    <!-- ═══ Quién ═══ -->
    <Panel rotulo="Quién" ancho="dos-tercios">
      <h1>{perfil.titular}</h1>
      <p class="presentacion">{perfil.presentacion}</p>

      <p class="acciones">
        <a class="boton" href="#taller">Ver lo que he construido</a>
        <a href="/casos">Los {totalCasos} contados en largo</a>
      </p>
    </Panel>

    <!-- ═══ Estado ═══ -->
    <Panel rotulo="Estado" ancho="tercio">
      <dl class="estado">
        <div><dt>Rol</dt><dd>{perfil.rol}</dd></div>
        <div>
          <dt>Dónde</dt>
          <dd><Organizacion nombre={perfil.organizacion} /> · {perfil.modalidad}</dd>
        </div>
        <div><dt>Base</dt><dd>{perfil.ubicacion}</dd></div>
        <div><dt>Taller</dt><dd>{taller.length} cosas, {enMarcha} andando</dd></div>
      </dl>

      <ul class="contacto">
        <li><a href={`mailto:${contacto.correo}`}>Escribirme</a></li>
        <li><a href={contacto.cv}>CV en PDF</a></li>
        <li><a href={contacto.linkedin} rel="noopener">LinkedIn</a></li>
        <li><a href={contacto.github} rel="noopener">GitHub</a></li>
      </ul>
    </Panel>

    <!-- ═══ Mediciones ═══ -->
    <Panel rotulo="Mediciones" nota="verificables, no adjetivos">
      <Cifras cifras={perfil.cifras} escala="grande" />
    </Panel>

    <!-- ═══ Se pueden abrir ═══ -->
    <Panel
      rotulo="Se pueden abrir"
      nota="no son capturas: se abren y se usan"
      desnudo
      id="abrir"
    >
      <Abribles />
    </Panel>

    <!-- ═══ El taller ═══ -->
    <Panel
      rotulo="El taller"
      nota={`${taller.length} cosas · ${enMarcha} andando · 4 destacadas`}
      desnudo
      id="taller"
    >
      <Taller />
    </Panel>

    <!-- ═══ Trayectoria ═══ -->
    <Panel rotulo="Trayectoria" nota="industria · lo reciente">
      <ol class="etapas">
        {
          resumenTrayectoria.map((etapa) => (
            <li>
              <p class="periodo">{rango(etapa.desde, etapa.hasta)}</p>
              <p class="cargo">
                <strong>{etapa.rol}</strong>
                <span><Organizacion nombre={etapa.organizacion} /></span>
              </p>
            </li>
          ))
        }
      </ol>
      <p class="mas">
        <a href="/trayectoria">Completa, con los cuatro años y medio de clases →</a>
      </p>
    </Panel>
  </div>
</Base>

<style>
  /* ═══ La consola ═══
     Reticula de doce columnas a sangre completa, sin columna centrada. Los
     paneles se pegan entre si y las lineas las dibuja cada uno con sombra,
     asi que no hay bordes dobles. */
  .consola {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: 0;
    max-inline-size: 96rem;
    margin-inline: auto;
    border-inline: 1px solid var(--linea-fuerte);
    border-block-end: 1px solid var(--linea-fuerte);
    overflow: hidden;
  }

  /* Bajo 60rem cada panel ocupa el ancho completo; la regla de columnas vive
     en Panel.astro y solo se activa en pantallas anchas. */
  @media (max-width: 59.999rem) {
    .consola {
      grid-template-columns: 1fr;
    }
  }

  h1 {
    font-size: var(--t-display);
    text-wrap: balance;
  }

  .presentacion {
    margin-top: var(--e-4);
    max-width: 44rem;
    font-size: var(--t-medio);
    color: var(--tinta-media);
  }

  .acciones {
    margin-top: var(--e-6);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--e-3) var(--e-5);
    font-family: var(--fuente-ui);
    font-size: var(--t-chico);
  }

  .boton {
    padding: 0.6em 1.1em;
    background: var(--tinta);
    color: var(--papel);
    border-radius: var(--radio);
    text-decoration: none;
    font-weight: 600;
  }

  .boton:hover {
    background: var(--acento);
    color: var(--papel);
  }

  /* ═══ Estado ═══ */
  .estado {
    margin: 0;
    display: grid;
    gap: var(--e-3);
    font-family: var(--fuente-ui);
    font-size: var(--t-chico);
  }

  .estado > div {
    display: grid;
    grid-template-columns: 4.5rem 1fr;
    gap: var(--e-3);
    align-items: baseline;
    padding-bottom: var(--e-3);
    border-bottom: 1px solid var(--linea);
  }

  .estado > div:last-child {
    border-bottom: 0;
    padding-bottom: 0;
  }

  .estado dt {
    font-size: var(--t-micro);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--tinta-suave);
  }

  .estado dd {
    margin: 0;
    text-wrap: pretty;
  }

  .contacto {
    margin: var(--e-5) 0 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: var(--e-2) var(--e-4);
    font-family: var(--fuente-ui);
    font-size: var(--t-chico);
  }

  /* ═══ Trayectoria ═══ */
  .etapas {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .etapas li {
    display: grid;
    grid-template-columns: minmax(0, 11rem) 1fr;
    gap: var(--e-2) var(--e-5);
    padding-block: var(--e-3);
    border-bottom: 1px solid var(--linea);
  }

  .etapas li:last-child {
    border-bottom: 0;
  }

  @media (max-width: 34rem) {
    .etapas li {
      grid-template-columns: 1fr;
    }
  }

  .periodo {
    margin: 0;
    font-family: var(--fuente-ui);
    font-size: var(--t-micro);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--tinta-suave);
    padding-top: 0.3em;
  }

  .cargo {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .cargo span {
    font-family: var(--fuente-ui);
    font-size: var(--t-chico);
    color: var(--tinta-media);
  }

  .mas {
    margin-top: var(--e-5);
    font-family: var(--fuente-ui);
    font-size: var(--t-chico);
  }
</style>
