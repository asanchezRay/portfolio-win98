---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Cifras from '../components/Cifras.astro';
import TarjetaCaso from '../components/TarjetaCaso.astro';
import { perfil } from '../data/perfil';
import { trayectoria, rango } from '../data/trayectoria';

const casos = (await getCollection('casos'))
  .filter((c) => c.data.destacado)
  .sort((a, b) => a.data.orden - b.data.orden);

const totalCasos = (await getCollection('casos')).length;

/** Solo las etapas de industria, y sin la de Vestuá, para el resumen de portada. */
const resumenTrayectoria = trayectoria.filter((e) => e.via === 'industria').slice(0, 4);
---

<Base
  titulo={`${perfil.nombre} — ${perfil.rol} en ${perfil.organizacion}`}
  tituloCrudo
  descripcion={`${perfil.rol} en ${perfil.organizacion}. Seis años construyendo software para el mercado eléctrico chileno y la nómina multipaís, entre ingeniería y negocio.`}
>
  <!-- ═══ Entrada ═══ -->
  <section class="documento entrada">
    <p class="rotulo">{perfil.ubicacion} · {perfil.modalidad}</p>
    <h1>{perfil.titular}</h1>
    <p class="presentacion">{perfil.presentacion}</p>

    <div class="a-medio bloque-cifras">
      <Cifras cifras={perfil.cifras} escala="grande" />
    </div>

    <p class="acciones">
      <a class="boton" href="/casos">Ver los {totalCasos} casos</a>
      <a href={perfil.contacto.cv}>CV en PDF</a>
      <a href={perfil.contacto.linkedin} rel="noopener">LinkedIn</a>
      <a href={`mailto:${perfil.contacto.correo}`}>Escribirme</a>
    </p>
  </section>

  <!-- ═══ Casos ═══ -->
  <section class="franja">
    <div class="documento">
      <div class="a-amplio encabezado-seccion">
        <h2>Casos</h2>
        <p>
          Decisiones técnicas con su contexto, sus alternativas y lo que costaron.
          Las que tienen interfaz van con capturas; las de infraestructura, con
          diagramas.
        </p>
      </div>

      <div class="a-amplio rejilla">
        {casos.map((caso) => <TarjetaCaso caso={caso} />)}
      </div>

      <p class="a-amplio mas">
        <a href="/casos">Todos los casos, incluidos los que no están acá →</a>
      </p>
    </div>
  </section>

  <!-- ═══ Trayectoria ═══ -->
  <section class="documento trayectoria-resumen">
    <div class="a-medio encabezado-seccion">
      <h2>Trayectoria</h2>
      <p>
        Seis años en el mercado eléctrico chileno, con un paso por nómina
        multipaís en el medio, y cuatro años y medio de docencia universitaria
        en paralelo a todo lo anterior.
      </p>
    </div>

    <ol class="a-medio etapas">
      {
        resumenTrayectoria.map((etapa) => (
          <li>
            <p class="periodo rotulo">{rango(etapa.desde, etapa.hasta)}</p>
            <p class="cargo">
              <strong>{etapa.rol}</strong>
              <span>{etapa.organizacion}</span>
            </p>
          </li>
        ))
      }
    </ol>

    <p class="a-medio mas">
      <a href="/trayectoria">Trayectoria completa, con la docencia →</a>
    </p>
  </section>
</Base>

<style>
  /* ═══ Entrada ═══ */
  .entrada {
    padding-block: clamp(var(--e-7), 9vh, var(--e-9)) var(--e-8);
  }

  .entrada h1 {
    margin-top: var(--e-4);
    font-size: var(--t-display);
    letter-spacing: -0.03em;
  }

  .presentacion {
    margin-top: var(--e-5);
    font-size: var(--t-medio);
    color: var(--tinta-media);
  }

  .bloque-cifras {
    margin-top: var(--e-8);
  }

  .acciones {
    margin-top: var(--e-7);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--e-3) var(--e-5);
    font-family: var(--fuente-ui);
    font-size: var(--t-chico);
  }

  .boton {
    padding: 0.6em 1.1em;
    background: var(--tinta);
    color: var(--papel);
    border-radius: var(--radio);
    text-decoration: none;
    font-weight: 600;
  }

  .boton:hover {
    background: var(--acento);
  }

  /* ═══ Secciones ═══ */
  .franja {
    padding-block: var(--e-8);
    border-block: var(--borde);
    background: var(--papel-hundido);
  }

  .encabezado-seccion h2 {
    font-size: var(--t-titulo);
  }

  .encabezado-seccion p {
    margin-top: var(--e-3);
    max-width: 34rem;
    color: var(--tinta-media);
    font-size: var(--t-chico);
  }

  .rejilla {
    margin-top: var(--e-6);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 19rem), 1fr));
    gap: var(--e-5);
  }

  .mas {
    margin-top: var(--e-5);
    font-family: var(--fuente-ui);
    font-size: var(--t-chico);
  }

  /* ═══ Trayectoria ═══ */
  .trayectoria-resumen {
    padding-block: var(--e-8);
  }

  .etapas {
    margin: var(--e-6) 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0;
  }

  .etapas li {
    display: grid;
    grid-template-columns: minmax(0, 11rem) 1fr;
    gap: var(--e-2) var(--e-5);
    padding-block: var(--e-4);
    border-top: var(--borde);
  }

  .etapas li:last-child {
    border-bottom: var(--borde);
  }

  @media (max-width: 34rem) {
    .etapas li {
      grid-template-columns: 1fr;
    }
  }

  .periodo {
    margin: 0;
    padding-top: 0.25em;
  }

  .cargo {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .cargo span {
    font-family: var(--fuente-ui);
    font-size: var(--t-chico);
    color: var(--tinta-media);
  }
</style>
