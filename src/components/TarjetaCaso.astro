---
import type { CollectionEntry } from 'astro:content';

/**
 * Tarjeta de caso para las rejillas.
 *
 * Dos tratamientos visuales segun lo que el caso pueda mostrar. Los casos de
 * producto tienen interfaz y llevan captura. Los de infraestructura y
 * practica no se pueden pantallazear, asi que en vez de inventarles una
 * imagen o de encoger un diagrama hasta volverlo ilegible, la tarjeta se
 * apoya en su cifra principal — que ademas es lo que mejor se lee de lejos.
 */
interface Props {
  caso: CollectionEntry<'casos'>;
}

const { caso } = Astro.props;
const { data } = caso;
const cifraPrincipal = data.cifras[0];
const conImagen = Boolean(data.imagen);
---

<article class:list={['tarjeta', data.tipo]}>
  <a href={`/casos/${caso.id}`}>
    <div class="visual">
      {
        conImagen ? (
          <img src={data.imagen!.src} alt={data.imagen!.alt} loading="lazy" decoding="async" />
        ) : cifraPrincipal ? (
          <p class="cifra-visual">
            <span class="v">{cifraPrincipal.valor}</span>
            {cifraPrincipal.unidad && <span class="u">{cifraPrincipal.unidad}</span>}
            <span class="e">{cifraPrincipal.etiqueta}</span>
          </p>
        ) : (
          <p class="cifra-visual sin-cifra"><span class="e">{data.organizacion}</span></p>
        )
      }
    </div>

    <div class="cuerpo">
      <p class="meta">
        <span>{data.organizacion}</span>
        <span aria-hidden="true">·</span>
        <span>{data.periodo}</span>
      </p>
      <h3>{data.titulo}</h3>
      <p class="resumen">{data.resumen}</p>
    </div>
  </a>
</article>

<style>
  .tarjeta {
    border: var(--borde);
    border-radius: var(--radio);
    background: var(--papel-elevado);
    overflow: hidden;
    transition: border-color 120ms ease;
  }

  .tarjeta:hover {
    border-color: var(--linea-fuerte);
  }

  a {
    display: grid;
    grid-template-rows: auto 1fr;
    block-size: 100%;
    color: inherit;
    text-decoration: none;
  }

  .visual {
    aspect-ratio: 16 / 9;
    display: grid;
    place-items: center;
    overflow: hidden;
    background: var(--papel-hundido);
    border-bottom: var(--borde);
  }

  .visual img {
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
    object-position: top center;
  }

  /* --- Cifra como visual --- */
  .cifra-visual {
    margin: 0;
    padding: var(--e-5);
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: center;
    gap: 0.1em;
    text-align: center;
    font-family: var(--fuente-ui);
  }

  .cifra-visual .v {
    font-size: clamp(2.75rem, 2rem + 3vw, 3.75rem);
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.04em;
    color: var(--dato-enfasis);
  }

  .cifra-visual .u {
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--dato-enfasis);
  }

  .cifra-visual .e {
    flex-basis: 100%;
    margin-top: var(--e-3);
    font-size: var(--t-mini);
    line-height: 1.4;
    color: var(--tinta-media);
    text-wrap: pretty;
  }

  .sin-cifra .e {
    margin-top: 0;
    font-size: var(--t-base);
  }

  /* --- Cuerpo --- */
  .cuerpo {
    padding: var(--e-5);
    display: grid;
    align-content: start;
    gap: var(--e-2);
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4em;
    margin: 0;
    font-family: var(--fuente-ui);
    font-size: var(--t-micro);
    color: var(--tinta-suave);
  }

  h3 {
    font-size: var(--t-grande);
    letter-spacing: -0.02em;
  }

  a:hover h3 {
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }

  .resumen {
    margin: var(--e-1) 0 0;
    color: var(--tinta-media);
    font-size: var(--t-chico);
    line-height: 1.55;
  }
</style>
