---
/**
 * Definiciones SVG compartidas por los diagramas: las puntas de flecha.
 *
 * Se declaran una vez por diagrama, dentro de su propio <svg>, porque un
 * marker referenciado desde otro documento SVG no se resuelve.
 */
---

<defs>
  <marker
    id="punta"
    viewBox="0 0 10 10"
    refX="9"
    refY="5"
    markerWidth="6"
    markerHeight="6"
    orient="auto-start-reverse"
  >
    <path d="M 0 1 L 9 5 L 0 9 z" class="punta-relleno" />
  </marker>

  <marker
    id="punta-enfasis"
    viewBox="0 0 10 10"
    refX="9"
    refY="5"
    markerWidth="6"
    markerHeight="6"
    orient="auto-start-reverse"
  >
    <path d="M 0 1 L 9 5 L 0 9 z" class="punta-relleno-enfasis" />
  </marker>
</defs>
