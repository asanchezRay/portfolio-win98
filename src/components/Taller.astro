---
import { taller, type Estado, type Pieza } from '../data/taller';

/**
 * El taller en dos pesos.
 *
 * Arriba, las pocas piezas que aguantan presencia propia: captura o cifra
 * grande, nombre y una linea corta. Abajo, el indice denso con TODO, una fila
 * por cosa y sin una sola descripcion.
 *
 * La version anterior era una rejilla de quince fichas iguales, cada una con
 * su frase. Eso son quince parrafos y cero jerarquia: "LeetCode" pesaba lo
 * mismo que "Organizatumatri", y lo chico le restaba a lo grande.
 */

const activo = (estado: Estado) =>
  estado === 'en curso' || estado === 'en producción' || estado === 'continuo';

const destacadas = taller.filter((p) => p.destacado);
const indice = taller;

const enlaceDe = (p: Pieza) =>
  p.caso ? `/casos/${p.caso}` : p.enlace ? p.enlace.href : null;
---

<div class="taller">
  <!-- ══ Destacadas ══ -->
  <ul class="destacadas">
    {
      destacadas.map((pieza) => {
        const href = enlaceDe(pieza);
        const Cuerpo = href ? 'a' : 'div';
        return (
          <li>
            <Cuerpo {...(href ? { href } : {})} class="tarjeta">
              <div class="visual">
                {pieza.imagen ? (
                  <img src={pieza.imagen.src} alt={pieza.imagen.alt} loading="lazy" decoding="async" />
                ) : pieza.cifra ? (
                  <p class="cifra">
                    <span class="v">{pieza.cifra.valor}</span>
                    {pieza.cifra.unidad && <span class="u">{pieza.cifra.unidad}</span>}
                    <span class="e">{pieza.cifra.etiqueta}</span>
                  </p>
                ) : null}
              </div>
              <div class="pie">
                <h3>{pieza.nombre}</h3>
                <p class="que">{pieza.que}</p>
              </div>
            </Cuerpo>
          </li>
        );
      })
    }
  </ul>

  <!-- ══ Índice ══ -->
  <table class="indice">
    <caption class="solo-lectores">
      Todo lo construido: año, estado, nombre, contexto y stack.
    </caption>
    <thead>
      <tr>
        <th scope="col" class="c-anio">Año</th>
        <th scope="col" class="c-estado">Estado</th>
        <th scope="col" class="c-que">Qué</th>
        <th scope="col" class="c-donde">Dónde</th>
        <th scope="col" class="c-stack">Stack</th>
      </tr>
    </thead>
    <tbody>
      {
        indice.map((pieza) => {
          const href = enlaceDe(pieza);
          return (
            <tr class:list={{ marcada: pieza.destacado }}>
              <td class="c-anio">{pieza.anios}</td>
              <td class="c-estado">
                <span class:list={['estado', { activo: activo(pieza.estado) }]}>
                  <span class="punto" aria-hidden="true" />
                  {pieza.estado}
                </span>
              </td>
              <th scope="row" class="c-que">
                {href ? <a href={href}>{pieza.nombre}</a> : pieza.nombre}
              </th>
              <td class="c-donde">{pieza.contexto}</td>
              <td class="c-stack">{pieza.tags.join(' · ')}</td>
            </tr>
          );
        })
      }
    </tbody>
  </table>
</div>

<style>
  /* ══ Destacadas ══ */
  .destacadas {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
    gap: 0;
    border-bottom: 1px solid var(--linea-fuerte);
  }

  .destacadas > li {
    min-inline-size: 0;
    box-shadow: 1px 0 0 var(--linea-fuerte);
  }

  .tarjeta {
    display: flex;
    flex-direction: column;
    block-size: 100%;
    color: inherit;
    text-decoration: none;
  }

  a.tarjeta:hover {
    background: var(--papel-hundido);
  }

  .visual {
    aspect-ratio: 16 / 10;
    display: grid;
    place-items: center;
    overflow: hidden;
    background: var(--papel);
    border-bottom: 1px solid var(--linea);
  }

  .visual img {
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
    object-position: top center;
  }

  .cifra {
    margin: 0;
    padding: var(--e-4);
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: center;
    gap: 0.08em;
    text-align: center;
  }

  .cifra .v {
    font-size: clamp(2.5rem, 1.6rem + 3.4vw, 3.5rem);
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.04em;
    color: var(--dato-enfasis);
  }

  .cifra .u {
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--dato-enfasis);
  }

  .cifra .e {
    flex-basis: 100%;
    margin-top: var(--e-2);
    font-size: var(--t-micro);
    line-height: 1.4;
    color: var(--tinta-suave);
  }

  .pie {
    padding: var(--e-4);
    display: grid;
    gap: var(--e-2);
    align-content: start;
  }

  .pie h3 {
    font-size: var(--t-chico);
  }

  a.tarjeta:hover h3 {
    color: var(--acento);
  }

  .que {
    margin: 0;
    font-size: var(--t-mini);
    line-height: 1.45;
    color: var(--tinta-media);
    text-wrap: pretty;
  }

  /* ══ Índice ══ */
  .indice {
    inline-size: 100%;
    border-collapse: collapse;
    font-size: var(--t-mini);
    font-variant-numeric: tabular-nums;
  }

  .indice thead th {
    padding: var(--e-2) var(--e-4);
    text-align: left;
    font-size: var(--t-micro);
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--tinta-suave);
    border-bottom: 1px solid var(--linea-fuerte);
    background: var(--papel-hundido);
    white-space: nowrap;
  }

  .indice td,
  .indice tbody th {
    padding: var(--e-2) var(--e-4);
    text-align: left;
    font-weight: 400;
    border-bottom: 1px solid var(--linea);
    vertical-align: baseline;
  }

  .indice tbody tr:hover {
    background: var(--papel-hundido);
  }

  /* Las que estan arriba como destacadas quedan marcadas en el indice, para
     que la lista y las tarjetas se lean como una sola cosa. */
  .indice tr.marcada .c-que {
    color: var(--tinta);
  }
  .indice tr.marcada .c-que::after {
    content: ' ●';
    color: var(--senal);
    font-size: 0.7em;
    vertical-align: 0.15em;
  }

  .c-anio { color: var(--tinta-suave); white-space: nowrap; }
  .c-que { color: var(--tinta); }
  .c-donde { color: var(--tinta-media); white-space: nowrap; }
  .c-stack { color: var(--tinta-suave); }

  .estado {
    display: inline-flex;
    align-items: center;
    gap: 0.45em;
    font-size: var(--t-micro);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--tinta-suave);
    white-space: nowrap;
  }

  .punto {
    inline-size: 5px;
    block-size: 5px;
    border-radius: 50%;
    border: 1.5px solid currentColor;
  }

  .estado.activo {
    color: var(--senal);
  }
  .estado.activo .punto {
    background: currentColor;
  }

  /* En pantallas angostas la tabla se reordena: el nombre manda y el resto
     baja como metadatos. Cinco columnas a 390 px no existen. */
  @media (max-width: 52rem) {
    .indice thead {
      display: none;
    }
    .indice,
    .indice tbody,
    .indice tr,
    .indice td,
    .indice tbody th {
      display: block;
      border: 0;
    }
    .indice tr {
      padding: var(--e-3) var(--e-4);
      border-bottom: 1px solid var(--linea);
    }
    .indice tbody th {
      padding: 0;
      font-size: var(--t-chico);
    }
    .indice td {
      padding: 0;
      display: inline;
    }
    /* Sin separadores: el siguiente dato va en su propia linea y el punto
       quedaba colgando al final. */
    .indice .c-anio,
    .indice .c-estado {
      display: inline;
    }
    .indice .c-anio::after {
      content: '  ';
      white-space: pre;
    }
    .indice tbody th {
      margin-top: var(--e-1);
    }
    .indice .c-donde,
    .indice .c-stack {
      display: block;
    }
    .indice .c-stack {
      margin-top: var(--e-1);
    }
  }
</style>
