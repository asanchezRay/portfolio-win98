---
/**
 * Layout raiz del portafolio.
 *
 * No importa nada de src/win98/: ese CSS fija overflow:hidden en html y body
 * mas la fuente y el fondo del escritorio, y romperia cualquier pagina con
 * scroll. El escritorio vive aislado en /98.
 */
import '../styles/tokens.css';
import '../styles/base.css';
import EncabezadoSitio from '../components/EncabezadoSitio.astro';
import PieSitio from '../components/PieSitio.astro';
import { perfil } from '../data/perfil';

interface Props {
  titulo: string;
  descripcion: string;
  /** Sin el sufijo del nombre; para la portada, que ya lo lleva. */
  tituloCrudo?: boolean;
  tipoOg?: 'website' | 'article';
}

const { titulo, descripcion, tituloCrudo = false, tipoOg = 'website' } = Astro.props;

const tituloCompleto = tituloCrudo ? titulo : `${titulo} · ${perfil.nombre}`;
const canonica = new URL(Astro.url.pathname, Astro.site);
const imagenOg = new URL('/og.png', Astro.site);
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />

    <title>{tituloCompleto}</title>
    <meta name="description" content={descripcion} />
    <link rel="canonical" href={canonica} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />


    <meta property="og:type" content={tipoOg} />
    <meta property="og:title" content={tituloCompleto} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:url" content={canonica} />
    <meta property="og:image" content={imagenOg} />
    <meta property="og:locale" content="es_CL" />
    <meta property="og:site_name" content={perfil.nombre} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={tituloCompleto} />
    <meta name="twitter:description" content={descripcion} />
    <meta name="twitter:image" content={imagenOg} />

    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'Person',
        name: perfil.nombre,
        jobTitle: perfil.rol,
        worksFor: { '@type': 'Organization', name: perfil.organizacion },
        url: Astro.site?.href,
        address: {
          '@type': 'PostalAddress',
          addressLocality: 'Concepción',
          addressCountry: 'CL',
        },
        knowsLanguage: ['es', 'en'],
        sameAs: [perfil.contacto.linkedin, perfil.contacto.github, perfil.contacto.gitlab],
      })}
    />
  </head>

  <body>
    <a class="saltar-al-contenido" href="#contenido">Saltar al contenido</a>
    <EncabezadoSitio />
    <main id="contenido">
      <slot />
    </main>
    <PieSitio />
  </body>
</html>
